{
  "name": "@kidthales/pgmmv-types",
  "version": "0.2.0-alpha.1",
  "description": "TypeScript definitions for PGMMV.",
  "license": "MIT",
  "author": "kidthales <kidthales@agogpixel.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kidthales/pgmmv-types.git"
  },
  "homepage": "https://github.com/kidthales/pgmmv-types#readme",
  "bugs": {
    "url": "https://github.com/kidthales/pgmmv-types/issues"
  },
  "keywords": [
    "pgmmv",
    "pixel-game-maker-mv",
    "typescript",
    "types",
    "declarations",
    "gamedev",
    "agtk",
    "cocos2d"
  ],
  "files": [
    "dist",
    "lib",
    "pgmmv.d.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./pgmmv.d.ts": "./pgmmv.d.ts",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.2.0"
  },
  "scripts": {
    "generate": "node tools/generate.mjs",
    "check:types": "tsc -p tests/fixtures/tsc/tsconfig.bundler.json --noEmit && tsc -p tests/fixtures/tsc/tsconfig.node16.json --noEmit",
    "lint": "tsc --noEmit && npm run check:types && node tools/lint.mjs",
    "test": "npm run lint && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "type-fest": "^5.4.4"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
